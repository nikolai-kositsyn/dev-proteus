{
  "buses": [
    {
      "name": "/dev/i2c-1",      
      "devices": [
        {
          "address": "0x51",
          "class": "i2c-echo",
          "name": "Echo Device"
        }
      ]
    },

    {
      "name": "/dev/i2c-2",
      "devices": [
        {
          "address": "0x52",
          "class": "i2c-eeprom",
