# dev-proteus - Hook Library Makefile

CC = gcc
CROSS_COMPILE ?=
TARGET_CC = $(CROSS_COMPILE)$(CC)

CFLAGS = -Wall -Wextra -O3 -fPIC -std=c99 -D_GNU_SOURCE
LDFLAGS = -shared -ldl -lpthread

# Source files
PROTEUS_SRC = proteus.c
HOOK_MANAGER_SRC = hook_manager.c
I2C_HOOK_SRC = i2c_hook.c
SPI_HOOK_SRC = spi_hook.c
UART_HOOK_SRC = uart_hook.c

ALL_SRC = $(PROTEUS_SRC) $(HOOK_MANAGER_SRC) $(I2C_HOOK_SRC) $(SPI_HOOK_SRC) $(UART_HOOK_SRC)
ALL_OBJ = $(ALL_SRC:.c=.o)

TARGET_LIB = libproteus_hook.so

.PHONY: all clean help

all: $(TARGET_LIB)

# Compile - config.h is generated by build_hooks.sh, not a dependency here
%.o: %.c common.h proteus.h
	$(TARGET_CC) $(CFLAGS) -c -o $@ $<

# Link library
$(TARGET_LIB): $(ALL_OBJ)
	$(TARGET_CC) $(LDFLAGS) -o $@ $^

# Clean
clean:
	rm -f $(ALL_OBJ) $(TARGET_LIB)

# Help
help:
	@echo "dev-proteus Hook Library Makefile"
	@echo ""
	@echo "Variables:"
	@echo "  CROSS_COMPILE    - Cross-compilation prefix"
	@echo ""
	@echo "Targets:"
	@echo "  all      - Build library (default)"
	@echo "  clean    - Remove build artifacts"
	@echo "  help     - Show this help"
	@echo ""
	@echo "Configuration is controlled by build_hooks.sh or environment variables:"
	@echo "  PROTEUS_HOST, PROTEUS_PORT, PROTEUS_ENABLE_*, PROTEUS_VERBOSE"